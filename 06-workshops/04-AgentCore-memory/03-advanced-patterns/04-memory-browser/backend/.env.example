# AgentCore Memory Backend 구성

# AWS 구성(설정하지 않으면 AWS CLI/profile에서 리전을 자동 감지)
# AWS_REGION=us-east-1

# 선택 사항: AWS Profile(여러 profile을 사용하는 경우)
# AWS_PROFILE=your-profile-name

# 서버 구성
# 보안: 로컬 개발에는 127.0.0.1 사용을 권장
# 네트워크의 다른 시스템에서 액세스해야 할 때만 0.0.0.0 사용
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DEBUG=true

# CORS 구성
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 참고: Memory ID, Actor ID, Session ID는 사용자가 dashboard UI에서 입력
# 이 파일에서 환경 변수로 구성할 필요 없음
