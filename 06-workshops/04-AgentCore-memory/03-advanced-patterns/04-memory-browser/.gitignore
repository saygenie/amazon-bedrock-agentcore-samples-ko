# 종속성
node_modules/
backend/venv/
backend/.venv/
.venv/

# 민감한 데이터 또는 개인 데이터가 포함된 환경 변수
# backend/.env - 정리되어 공유해도 안전함

# 두 .env 파일에는 민감하지 않은 구성만 있으므로 모두 유지
# .env (frontend) - 공유해도 안전함
# backend/.env - 공유해도 안전함(개인 AWS profile 제거됨)

# Python 캐시
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# 빌드 출력
build/
dist/

# IDE 파일
.vscode/
.idea/
*.swp
*.swo

# OS 파일
.DS_Store
Thumbs.db

# 로그
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 런타임 데이터
pids
*.pid
*.seed
*.pid.lock

# istanbul과 같은 도구에서 사용하는 커버리지 디렉터리
coverage/

# nyc 테스트 커버리지
.nyc_output

# 종속성 디렉터리
jspm_packages/

# 선택적 npm cache 디렉터리
.npm

# 선택적 REPL 기록
.node_repl_history

# 'npm pack'의 출력
*.tgz

# Yarn 무결성 파일
.yarn-integrity

